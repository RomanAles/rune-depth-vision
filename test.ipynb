   "source": [
    "import cv2\n",
    "\n",
    "for i in range(10):\n",
    "    cap = cv2.VideoCapture(i)\n",
    "    if cap.isOpened():\n",
    "        ret, frame = cap.read()\n",
    "        if ret:\n",
    "            print(f\"Камера найдена: index={i}, resolution={frame.shape[1]}x{frame.shape[0]}\")\n",
    "        cap.release()"
   ]
  }
